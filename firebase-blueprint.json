{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Catalog product sold by SNAP CELL (phones, accessories, perfumes, bags, watches & smart glasses).",
      "type": "object",
      "properties": {
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 140 },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 140 },
        "brand": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "condition": { "type": "string", "enum": ["new", "used"] },
        "inStock": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "isSale": { "type": "boolean" },
        "size": { "type": "string", "maxLength": 40 },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "descriptionAr": { "type": "string", "maxLength": 1000 },
        "options": { "type": "array" },
        "images": { "type": "array" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "nameEn",
        "nameAr",
        "brand",
        "category",
        "price",
        "condition",
        "inStock",
        "isNew",
        "isSale",
        "options",
        "images",
        "order",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Storefront product category card.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-z0-9_\\-]+$" },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 80 },
        "image": { "type": "string", "maxLength": 2000 },
        "order": { "type": "number" }
      },
      "required": ["key", "nameEn", "nameAr", "image", "order"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Store service card (Buy, Sell, Repair).",
      "type": "object",
      "properties": {
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 100 },
        "titleAr": { "type": "string", "minLength": 1, "maxLength": 100 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "descriptionAr": { "type": "string", "minLength": 1, "maxLength": 400 },
        "icon": { "type": "string", "minLength": 1, "maxLength": 40 },
        "whatsappMessageEn": { "type": "string", "maxLength": 400 },
        "whatsappMessageAr": { "type": "string", "maxLength": 400 },
        "order": { "type": "number" }
      },
      "required": [
        "titleEn",
        "titleAr",
        "descriptionEn",
        "descriptionAr",
        "icon",
        "whatsappMessageEn",
        "whatsappMessageAr",
        "order"
      ]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "In-store showcase gallery image.",
      "type": "object",
      "properties": {
        "titleEn": { "type": "string", "maxLength": 120 },
        "titleAr": { "type": "string", "maxLength": 120 },
        "image": { "type": "string", "maxLength": 2000 },
        "order": { "type": "number" }
      },
      "required": ["titleEn", "titleAr", "image", "order"]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Global storefront hero and contact settings.",
      "type": "object",
      "properties": {
        "heroTitleEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "heroTitleAr": { "type": "string", "minLength": 1, "maxLength": 160 },
        "heroSubtitleEn": { "type": "string", "maxLength": 300 },
        "heroSubtitleAr": { "type": "string", "maxLength": 300 },
        "heroImage": { "type": "string", "maxLength": 2000 },
        "phoneDisplay": { "type": "string", "minLength": 1, "maxLength": 40 },
        "whatsappNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "addressEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "addressAr": { "type": "string", "minLength": 1, "maxLength": 200 },
        "hoursEn": { "type": "string", "maxLength": 160 },
        "hoursAr": { "type": "string", "maxLength": 160 },
        "mapsLink": { "type": "string", "maxLength": 1000 },
        "mapsEmbedUrl": { "type": "string", "maxLength": 1000 },
        "facebookUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "heroTitleEn",
        "heroTitleAr",
        "heroSubtitleEn",
        "heroSubtitleAr",
        "heroImage",
        "phoneDisplay",
        "whatsappNumber",
        "addressEn",
        "addressAr",
        "hoursEn",
        "hoursAr",
        "mapsLink",
        "mapsEmbedUrl",
        "facebookUrl",
        "updatedAt"
      ]
    },
    "AppMeta": {
      "title": "AppMeta",
      "description": "One-time setup completion status marker.",
      "type": "object",
      "properties": {
        "setupComplete": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["setupComplete", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Storefront products catalog"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Storefront category cards"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Storefront buy/sell/repair service cards"
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Storefront photo gallery"
    },
    "/shopSettings/{docId}": {
      "schema": { "$ref": "#/entities/ShopSettings" },
      "description": "Hero and contact settings"
    },
    "/appMeta/{docId}": {
      "schema": { "$ref": "#/entities/AppMeta" },
      "description": "Setup completion flag"
    }
  }
}
